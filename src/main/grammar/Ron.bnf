{
  parserClass="com.github.unclepomedev.ronassist.parser.RonParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Ron"
  psiImplClassSuffix="Impl"
  psiPackage="com.github.unclepomedev.ronassist.psi"
  psiImplPackage="com.github.unclepomedev.ronassist.psi.impl"

  elementTypeHolderClass="com.github.unclepomedev.ronassist.psi.RonTypes"
  elementTypeClass="com.github.unclepomedev.ronassist.psi.RonElementType"
  tokenTypeClass="com.github.unclepomedev.ronassist.psi.RonTokenType"

  tokens=[
    LBRACE="{"
    RBRACE="}"
    LPAREN="("
    RPAREN=")"
    LBRACK="["
    RBRACK="]"
    COLON=":"
    COMMA=","
    TRUE="true"
    FALSE="false"
    SOME="Some"
    NONE="None"

    LINE_COMMENT="regexp://.*"
    BLOCK_COMMENT="regexp:/\*([^*]|\*+[^*/])*\*+/"

    IDENTIFIER="regexp:[a-zA-Z_][a-zA-Z0-9_]*"

    // Same patterns as Ron.flex — kept permissive on purpose (see Ron.flex for details).
    STRING="regexp:\"([^\"\\\n\r]|\\.)*\"?"
    RAW_STRING="regexp:r#+\"([^\"]|\"[^#])*(\"#+)?|r\"[^\"]*\"?"
    CHAR="regexp:'([^'\\\n\r]|\\.)?'?"
    FLOAT="regexp:-?[0-9]+\.[0-9]*(e[+-]?[0-9]+)?(f32|f64)?"
    INTEGER="regexp:-?(0x[0-9a-fA-F]+|0b[01]+|0o[0-7]+|[0-9]+)(u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|usize|isize)?"
  ]
}

ronFile ::= value

value ::= option
        | boolean
        | numeric
        | string_val
        | char_val
        | list
        | map
        | struct_or_tuple
        | IDENTIFIER

boolean ::= TRUE | FALSE
option ::= SOME LPAREN value RPAREN | NONE
numeric ::= FLOAT | INTEGER
string_val ::= STRING | RAW_STRING
char_val ::= CHAR

list ::= LBRACK value_list? RBRACK
private value_list ::= value (COMMA? value)* COMMA?

private value_first ::= IDENTIFIER | STRING | RAW_STRING | CHAR | FLOAT | INTEGER | TRUE | FALSE | SOME | NONE | LBRACK | LBRACE | LPAREN

map ::= LBRACE map_entry_list? RBRACE
private map_entry_list ::= map_entry (COMMA? map_entry)* COMMA?

// pin=1 commits the node on the first key to preserve AST structure for the formatter.
// Optional commas and recoverWhile prevent syntax errors from swallowing sibling entries.
map_entry ::= value COLON value { pin=1 recoverWhile=map_entry_recover }
private map_entry_recover ::= !(COMMA | RPAREN | RBRACE | RBRACK | value_first)

struct_or_tuple ::= IDENTIFIER? LPAREN entries? RPAREN
private entries ::= struct_entries | tuple_entries
private struct_entries ::= struct_entry_first (COMMA? struct_entry)* COMMA?

// The first entry uses pin=2 to differentiate structs from tuples.
// Subsequent entries use pin=1 to preserve AST structure even if colons or commas are missing.
struct_entry_first ::= IDENTIFIER COLON value { elementType=struct_entry pin=2 recoverWhile=struct_entry_recover }
struct_entry ::= IDENTIFIER COLON value { pin=1 recoverWhile=struct_entry_recover }
private struct_entry_recover ::= !(COMMA | RPAREN | RBRACE | RBRACK | IDENTIFIER)
private tuple_entries ::= value (COMMA? value)* COMMA?
