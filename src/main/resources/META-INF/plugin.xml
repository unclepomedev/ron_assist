<idea-plugin>
    <id>com.github.unclepomedev.ronassist</id>
    <name>RON Assist</name>
    <vendor>unclepomedev</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="RON"
                language="RON"
                extensions="ron"
                implementationClass="com.github.unclepomedev.ronassist.lang.RonFileType"/>

        <lang.parserDefinition
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.parser.RonParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.highlighting.RonSyntaxHighlighterFactory"/>
        <colorSettingsPage
                implementation="com.github.unclepomedev.ronassist.highlighting.RonColorSettingsPage"/>
        <annotator
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.highlighting.RonAnnotator"/>
        <lang.psiStructureViewFactory
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.editor.structureview.RonStructureViewFactory"/>
        <breadcrumbsInfoProvider
                implementation="com.github.unclepomedev.ronassist.editor.breadcrumbs.RonBreadcrumbsProvider"/>

        <lang.formatter
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.formatting.RonFormattingModelBuilder"/>
        <postFormatProcessor
                implementation="com.github.unclepomedev.ronassist.formatting.RonPostFormatProcessor"/>
        <langCodeStyleSettingsProvider
                implementation="com.github.unclepomedev.ronassist.formatting.RonLanguageCodeStyleSettingsProvider"/>

        <lang.braceMatcher
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.editor.RonBraceMatcher"/>
        <lang.quoteHandler
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.editor.RonQuoteHandler"/>
        <lang.commenter
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.editor.RonCommenter"/>
        <lang.foldingBuilder
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.editor.folding.RonFoldingBuilder"/>
        <lang.smartEnterProcessor
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.editor.RonSmartEnterProcessor"/>
        <enterBetweenBracesDelegate
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.editor.RonEnterBetweenBracesDelegate"/>

        <codeFoldingOptionsProvider
                instance="com.github.unclepomedev.ronassist.editor.folding.RonCodeFoldingOptionsProvider"/>

        <localInspection
                language="RON"
                groupPath="RON"
                groupKey="inspection.settings.group.name"
                bundle="messages.RonInspectionBundle"
                key="inspection.map.duplicate.key.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.github.unclepomedev.ronassist.inspection.RonDuplicateMapKeyInspection"/>
        <localInspection
                language="RON"
                groupPath="RON"
                groupKey="inspection.settings.group.name"
                bundle="messages.RonInspectionBundle"
                key="inspection.struct.duplicate.field.display.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.github.unclepomedev.ronassist.inspection.RonDuplicateStructFieldInspection"/>
        <spellchecker.support
                language="RON"
                implementationClass="com.github.unclepomedev.ronassist.spellchecker.RonSpellcheckingStrategy"/>

        <defaultLiveTemplates file="liveTemplates/ron.xml"/>
        <liveTemplateContext
                contextId="RON"
                implementation="com.github.unclepomedev.ronassist.livetemplates.RonTemplateContextType"/>
        <internalFileTemplate name="RON File"/>
    </extensions>

    <actions>
        <group id="Ron.NewFileGroup">
            <separator/>
            <action id="Ron.NewRonFile"
                    class="com.github.unclepomedev.ronassist.actions.CreateRonFileAction"/>
            <add-to-group group-id="NewGroup" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
